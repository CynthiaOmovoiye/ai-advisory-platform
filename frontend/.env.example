# Frontend configuration. Copy to .env.local.

# Backend API base (FastAPI).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1

# Auth.js secret. MUST equal the backend's AUTH_SECRET — it both signs the Auth.js
# session AND signs the BFF service token the backend verifies (ADR-0009).
AUTH_SECRET=change-me-must-match-backend-AUTH_SECRET

# Auth.js base URL.
AUTH_URL=http://localhost:3000
