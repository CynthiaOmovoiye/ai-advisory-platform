# =============================================================================
# AI Advisory Platform — configuration surface
# Copy to .env and fill in. NEVER commit a real .env.
# NOTE: keep comments on their OWN lines — python-dotenv folds a trailing
# "# ..." into the value, which silently breaks things.
# See docs/security/security-review.md (secrets handling).
# =============================================================================

# --- Core ---
APP_ENV=development
LOG_LEVEL=info

# --- Database (Postgres + pgvector) ---
POSTGRES_USER=advisory
POSTGRES_PASSWORD=change-me
POSTGRES_DB=advisory
DATABASE_URL=postgresql+psycopg://advisory:change-me@postgres:5432/advisory
# App connects as a non-superuser role so Postgres RLS is enforced (ADR-0006):
APP_DATABASE_URL=postgresql+psycopg://app_role:app_role_pw@postgres:5432/advisory

# --- Redis (cache + Celery broker/result backend) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Object storage (MinIO locally; S3-compatible in prod) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET=advisory-documents
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1

# --- Auth (ADR-0007 / ADR-0009) ---
# Shared HS256 secret: signs the Auth.js session AND the BFF service token the API
# verifies. The web and api MUST use the same value. Use >= 32 bytes in production.
AUTH_SECRET=change-me-32-bytes-min-shared-secret
AUTH_URL=http://localhost:3000
# Local dev returns one-time email verification tokens from signup so the BFF can
# verify immediately without SMTP. Set false in production and deliver tokens by email.
LOCAL_EMAIL_VERIFICATION_TOKENS=true

# --- Email delivery (verification + password reset) ---
# Public web URL used to build the links inside emails (e.g. {APP_BASE_URL}/verify-email).
APP_BASE_URL=http://localhost:3000
# Provider: console | smtp | resend.
#   console — logs the email; the safe default, no creds needed (pairs with the dev
#             verification-token flow above).
#   smtp    — any SMTP server. Mailtrap works directly: set SMTP_* below.
#   resend  — Resend HTTP API: set RESEND_API_KEY below.
# A provider selected without its credentials degrades to console (never blocks signup).
EMAIL_PROVIDER=console
# Verified sender. Resend requires a verified domain (or onboarding@resend.dev in test).
# Mailtrap sandbox accepts any From.
EMAIL_FROM=AI Advisory <onboarding@resend.dev>
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# SMTP / Mailtrap (used when EMAIL_PROVIDER=smtp). For the Mailtrap sandbox inbox use
# host sandbox.smtp.mailtrap.io and the username/password from your inbox's SMTP tab.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Resend (used when EMAIL_PROVIDER=resend).
RESEND_API_KEY=

# --- LLM via OpenRouter (ADR-0004) ---
# Leave OPENROUTER_API_KEY EMPTY to run fully offline on the deterministic grounded
# mock. Set a real key to enable live enhancement.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_DEFAULT_MODEL=anthropic/claude-3.5-sonnet
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- API security ---
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BYTES=1048576
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend (server-side BFF -> API base URL) ---
API_BASE_URL=http://api:8000/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1

# Host port the web app is published on. If 3000 is taken, override here (the compose
# web service maps ${WEB_PORT}:3000 and derives AUTH_URL from it). When you change this,
# also update AUTH_URL, APP_BASE_URL, and CORS_ALLOWED_ORIGINS above to the same port so
# Auth.js, the emailed links, and CORS all agree.
WEB_PORT=3000
