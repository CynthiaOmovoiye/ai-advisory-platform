# =============================================================================
# AI Advisory Platform — configuration surface
# Copy to .env and fill in. NEVER commit a real .env. No secret has a real
# default here. See docs/security/security-review.md (secrets handling).
# =============================================================================

# --- Core ---
APP_ENV=development                      # development | staging | production
LOG_LEVEL=info

# --- Database (Postgres + pgvector) ---
POSTGRES_USER=advisory
POSTGRES_PASSWORD=change-me
POSTGRES_DB=advisory
DATABASE_URL=postgresql+psycopg://advisory:change-me@postgres:5432/advisory

# --- Redis (cache + Celery broker/result backend) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Object storage (MinIO locally; S3-compatible in prod) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET=advisory-documents
STORAGE_REGION=us-east-1
# In production set these to the S3 endpoint/creds; the storage client is abstracted.

# --- Auth (Auth.js / Better Auth) ---  (ADR-0007)
AUTH_SECRET=change-me-32-bytes-min       # session signing secret
AUTH_URL=http://localhost:3000
# SMTP for email verification / password reset:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com

# --- Field encryption (sensitive columns at rest) ---
FIELD_ENCRYPTION_KEY=change-me-base64-32-bytes

# --- LLM via OpenRouter ---  (ADR-0004)
OPENROUTER_API_KEY=                      # HIGH-VALUE SECRET — required for enhancement
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_DEFAULT_MODEL=anthropic/claude-...   # overridden per model_versions row
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Cost guardrails (denial-of-wallet protection):
LLM_PER_ORG_DAILY_BUDGET_USD=25
LLM_GLOBAL_RATE_LIMIT_PER_MIN=120

# --- API security ---
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BYTES=1048576                # 1 MiB JSON bodies
MAX_UPLOAD_BYTES=26214400                # 25 MiB file uploads
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1
